      "package": "com.assgard.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "60e607dd-3558-4a18-91be-9d651a98ee44"
      }
    },
    "primaryColor": "#F5C518"
